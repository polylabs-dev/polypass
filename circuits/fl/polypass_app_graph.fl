// ═══════════════════════════════════════════════════════════════════════════════
// Graph Registration
// ═══════════════════════════════════════════════════════════════════════════════

circuit polypass_app_graph_register(
    graph: CsrStorage
) -> CsrStorage
    lex polylabs/polypass
    @status production
    @precision B
    @attested true
    invariant "capacity" { graph.num_nodes + POLYPASS_MODULE_COUNT as u32 <= 4096 }
    observe metrics: [registered_module_count, registered_edge_count]
    meters [compute_cycles, memory_bytes]
{
    // ── Add all 12 modules ──────────────────────────────────────────────────
    let (g, id_encrypt)         = module_graph_add_module(graph, polypass_encrypt_module())
    let (g, id_autofill)        = module_graph_add_module(g, polypass_autofill_module())
    let (g, id_breach)          = module_graph_add_module(g, polypass_breach_module())
    let (g, id_totp)            = module_graph_add_module(g, polypass_totp_module())
    let (g, id_share)           = module_graph_add_module(g, polypass_share_module())
    let (g, id_import)          = module_graph_add_module(g, polypass_import_module())
    let (g, id_rbac)            = module_graph_add_module(g, polypass_rbac_module())
    let (g, id_audit)           = module_graph_add_module(g, polypass_audit_module())
    let (g, id_metering)        = module_graph_add_module(g, polypass_metering_module())
    let (g, id_platform_health) = module_graph_add_module(g, polypass_platform_health_module())
    let (g, id_vault_graph)     = module_graph_add_module(g, vault_graph_module())
    let (g, id_share_graph)     = module_graph_add_module(g, share_graph_module())

    // ── Intra-graph REQUIRES edges ──────────────────────────────────────────

    // polypass_autofill -> polypass_encrypt, vault_graph
    let g = module_graph_add_edge(g, make_requires_edge("polypass_autofill", "polypass_encrypt"), id_autofill, id_encrypt)
    let g = module_graph_add_edge(g, make_requires_edge("polypass_autofill", "vault_graph"), id_autofill, id_vault_graph)

    // polypass_breach -> polypass_encrypt, vault_graph
    let g = module_graph_add_edge(g, make_requires_edge("polypass_breach", "polypass_encrypt"), id_breach, id_encrypt)
    let g = module_graph_add_edge(g, make_requires_edge("polypass_breach", "vault_graph"), id_breach, id_vault_graph)

    // polypass_totp -> polypass_encrypt
    let g = module_graph_add_edge(g, make_requires_edge("polypass_totp", "polypass_encrypt"), id_totp, id_encrypt)

    // polypass_share -> polypass_encrypt, polypass_rbac, share_graph
    let g = module_graph_add_edge(g, make_requires_edge("polypass_share", "polypass_encrypt"), id_share, id_encrypt)
    let g = module_graph_add_edge(g, make_requires_edge("polypass_share", "polypass_rbac"), id_share, id_rbac)
    let g = module_graph_add_edge(g, make_requires_edge("polypass_share", "share_graph"), id_share, id_share_graph)

    // polypass_import -> polypass_encrypt, vault_graph
    let g = module_graph_add_edge(g, make_requires_edge("polypass_import", "polypass_encrypt"), id_import, id_encrypt)
    let g = module_graph_add_edge(g, make_requires_edge("polypass_import", "vault_graph"), id_import, id_vault_graph)

    // polypass_audit -> polypass_rbac, vault_graph
    let g = module_graph_add_edge(g, make_requires_edge("polypass_audit", "polypass_rbac"), id_audit, id_rbac)
    let g = module_graph_add_edge(g, make_requires_edge("polypass_audit", "vault_graph"), id_audit, id_vault_graph)

    // polypass_metering -> vault_graph
    let g = module_graph_add_edge(g, make_requires_edge("polypass_metering", "vault_graph"), id_metering, id_vault_graph)

    // polypass_platform_health -> polypass_encrypt, vault_graph
    let g = module_graph_add_edge(g, make_requires_edge("polypass_platform_health", "polypass_encrypt"), id_platform_health, id_encrypt)
    let g = module_graph_add_edge(g, make_requires_edge("polypass_platform_health", "vault_graph"), id_platform_health, id_vault_graph)

    // vault_graph -> polypass_encrypt
    let g = module_graph_add_edge(g, make_requires_edge("vault_graph", "polypass_encrypt"), id_vault_graph, id_encrypt)

    // share_graph -> polypass_rbac
    let g = module_graph_add_edge(g, make_requires_edge("share_graph", "polypass_rbac"), id_share_graph, id_rbac)

    g
}

// ═══════════════════════════════════════════════════════════════════════════════
// Cross-Graph Bridge Edges — PolyOAuth + PolyAuthenticator
// ═══════════════════════════════════════════════════════════════════════════════

circuit polypass_register_bridge_edges(
    graph: CsrStorage,
    polyoauth_lex: string,
    polyauthenticator_lex: string
) -> CsrStorage
    lex polylabs/polypass
    @status production
    @precision B
    @attested true
    observe metrics: [bridge_count]
    meters [compute_cycles]
{
    let autofill_id = 0xFFFFFFFF as u32
    let totp_id = 0xFFFFFFFF as u32

    for i in 0..graph.num_nodes {
        let node_data = graph.node_data[i]
        let module = deserialize(node_data) as ModuleNode
        if module.name == "polypass_autofill" {
            autofill_id = i
        }
        if module.name == "polypass_totp" {
            totp_id = i
        }
    }

    let g = graph

    // polypass_autofill -> PolyOAuth (SSO autofill routing)
    if autofill_id != 0xFFFFFFFF as u32 {
        let oauth_bridge = InterAppEdge {
            edge_type: EDGE_BRIDGE_TO,
            source_lex: POLYPASS_APP_LEX,
            source_module: "polypass_autofill",
            target_lex: polyoauth_lex,
            target_module: "polyoauth_sso",
            bridge_scope: BridgeScope::Product as u8,
            shared_fields: ["spark_id", "sso_session_token", "credential_origin"],
            redacted_fields: ["vault_master_key", "credential_password"],
            bilateral_confirmed: false,
        }
        g = module_graph_add_bridge_edge(g, oauth_bridge, autofill_id)
    }

    // polypass_totp -> PolyAuthenticator (TOTP seed sync + FIDO2 store)
    if totp_id != 0xFFFFFFFF as u32 {
        let auth_bridge = InterAppEdge {
            edge_type: EDGE_BRIDGE_TO,
            source_lex: POLYPASS_APP_LEX,
            source_module: "polypass_totp",
            target_lex: polyauthenticator_lex,
            target_module: "polyauthenticator_core",
            bridge_scope: BridgeScope::Product as u8,
            shared_fields: ["totp_seed_encrypted", "totp_issuer", "totp_account", "fido2_credential_id"],
            redacted_fields: ["vault_master_key"],
            bilateral_confirmed: false,
        }
        g = module_graph_add_bridge_edge(g, auth_bridge, totp_id)
    }

    g
}

// ═══════════════════════════════════════════════════════════════════════════════
// Golden Tests
// ═══════════════════════════════════════════════════════════════════════════════

#[test]
circuit test_polypass_module_count()
    lex polylabs/polypass
{
    let graph = CsrStorage::new(4096)
    let g = polypass_app_graph_register(graph)
    assert(g.num_nodes == 12, "expected 12 modules")
}

#[test]
circuit test_polypass_encrypt_is_premium()
    lex polylabs/polypass
{
    let m = polypass_encrypt_module()
    assert(m.sla_tier == SLATier::Premium as u8, "encrypt must be Premium SLA")
    assert(m.aperture_partition == AperturePartition::Backend as u8, "encrypt must be Backend")
}

#[test]
circuit test_polypass_bridge_edges()
    lex polylabs/polypass
{
    let graph = CsrStorage::new(4096)
    let g = polypass_app_graph_register(graph)
    let g = polypass_register_bridge_edges(g, "polylabs/polyoauth", "polylabs/polyauthenticator")
    assert(g.bridge_edge_count >= 2, "expected at least 2 bridge edges")
}

#[test]
circuit test_polypass_autofill_offline_first()
    lex polylabs/polypass
{
    let m = polypass_autofill_module()
    assert(m.offline_cache_policy == OfflineCachePolicy::OfflineFirst as u8, "autofill must be offline-first")
}
