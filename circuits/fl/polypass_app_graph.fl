/// Spec: specs/POLYPASS_CE_APP_GRAPH_SPEC.md
/// App Graph for PolyPass — 12 ModuleNode definitions (10 circuits + 2 graphs)
/// composing the PQ password manager. Registers intra-graph REQUIRES edges,
/// bridge edges to PolyOAuth + PolyAuthenticator, and golden tests.

lex polylabs/polypass

@target software
@codegen_targets ["wasm", "rust", "wasm-browser"]

import "core/deployment/module_stratum.fl" {
    ModuleNode, ModuleEdge, InterAppEdge, CsrStorage,
    CompilationReceipt, ResourceBudget8D, SemVer, CanaryTarget,
    ModuleType, AperturePartition, ModuleState, RolloutState,
    PersistencePolicy, OfflineCachePolicy, SLATier, EntitlementTier,
    EnforcementMode, BridgeScope,
    module_graph_add_module, module_graph_add_edge,
    module_graph_add_bridge_edge,
    EDGE_REQUIRES, EDGE_BRIDGE_TO,
}

// ── Constants ──────────────────────────────────────────────────────────────────

const POLYPASS_VERSION_MAJOR: u32 = 0
const POLYPASS_VERSION_MINOR: u32 = 1
const POLYPASS_VERSION_PATCH: u32 = 0
const POLYPASS_APP_LEX: string = "polylabs/polypass"
const POLYPASS_VERSION_STR: string = "0.1.0"
const POLYPASS_MODULE_COUNT: u64 = 12

// ── Helpers ────────────────────────────────────────────────────────────────────

circuit polypass_placeholder_receipt() -> CompilationReceipt
    lex polylabs/polypass
    @status production
    @precision D
{
    CompilationReceipt {
        source_hash: bytes(32, 0x00),
        compiler_version: SemVer {
            major: POLYPASS_VERSION_MAJOR,
            minor: POLYPASS_VERSION_MINOR,
            patch: POLYPASS_VERSION_PATCH,
            pre_release: "",
        },
        output_hash: bytes(32, 0x00),
        prime_device_id: None,
        compilation_timestamp: 0,
        reproducible_verified: false,
        receipt_signature: bytes(4627, 0x00),
    }
}

circuit make_polypass_module(
    name: string,
    aperture: u8,
    cache_policy: u8,
    sla: u8,
    budget: ResourceBudget8D
) -> ModuleNode
    lex polylabs/polypass
    @status production
    @precision C
    observe metrics: [module_name, aperture_partition]
    meters [compute_cycles]
{
    ModuleNode {
        name: name,
        version_major: POLYPASS_VERSION_MAJOR,
        version_minor: POLYPASS_VERSION_MINOR,
        version_patch: POLYPASS_VERSION_PATCH,
        version_pre: "",
        module_type: ModuleType::SmartCircuit as u8,
        content_hash: bytes(32, 0x00),
        signature_chain: bytes(0),
        aperture_partition: aperture,
        role_set: ["Owner", "FamilyMember", "TeamAdmin", "Auditor"],
        required_entitlement: EntitlementTier::Free as u8,
        classification_domains: [],
        max_classification_level: 0,
        compilation_receipt: polypass_placeholder_receipt(),
        source_hash: bytes(32, 0x00),
        compiler_version_major: POLYPASS_VERSION_MAJOR,
        compiler_version_minor: POLYPASS_VERSION_MINOR,
        prime_device_id: bytes(0),
        reproducible_verified: false,
        resource_budget: budget,
        budget_enforcement_mode: EnforcementMode::Hard as u8,
        state: ModuleState::Active as u8,
        rollout_state: RolloutState::Canary as u8,
        canary_target: None,
        persistence: PersistencePolicy::Persistent as u8,
        offline_cache_policy: cache_policy,
        max_staleness_seconds: 86400,
        sla_tier: sla,
        preferred_locality: "edge",
        created_at_ms: 0,
        updated_at_ms: 0,
    }
}

circuit make_requires_edge(
    source: string,
    target: string
) -> ModuleEdge
    lex polylabs/polypass
    @status production
    @precision D
{
    ModuleEdge {
        edge_type: EDGE_REQUIRES,
        source_module: source,
        source_version: POLYPASS_VERSION_STR,
        target_module: target,
        target_version_constraint: ">=" ++ POLYPASS_VERSION_STR,
        metadata: bytes(0),
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Module Definitions — 12 ModuleNodes (10 circuits + 2 graphs)
// ═══════════════════════════════════════════════════════════════════════════════

// ── polypass_encrypt ── PQ vault encryption, ML-KEM-1024 key wrap ────────────

circuit polypass_encrypt_module() -> ModuleNode
    lex polylabs/polypass
    @status production
    @precision B
    observe metrics: [module_init]
    meters [compute_cycles]
{
    make_polypass_module(
        "polypass_encrypt",
        AperturePartition::Backend as u8,
        OfflineCachePolicy::OfflineFirst as u8,
        SLATier::Premium as u8,
        ResourceBudget8D {
            execution: 200000,
            hash_ops: 10000,
            bandwidth: 30000,
            storage: 100000,
            observe_events: 5000,
            proofs: 200,
            consensus: 50,
            memory: 33554432,
        }
    )
}

