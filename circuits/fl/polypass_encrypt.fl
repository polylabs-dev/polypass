/// Poly Pass Encryption — Per-credential PQ encryption & vault key management
/// AES-256-GCM per-credential encryption, ML-KEM-1024 vault key wrapping
/// govern lex esn/global/org/polylabs/pass

import polykit_identity
import polykit_metering

// ── Types ───────────────────────────────────────────────────────

type VaultKey = bytes(32)
type CredentialKey = bytes(32)
type Nonce = bytes(12)
type Ciphertext = bytes

type EncryptedCredential = struct {
    credential_id: bytes(16),
    nonce: Nonce,
    ciphertext: Ciphertext,
    aad: bytes(64),
    tag: bytes(16),
}

type WrappedVaultKey = struct {
    kem_ciphertext: bytes(1568),
    wrapped_key: bytes(48),
    nonce: Nonce,
}

type VaultKeyRotation = struct {
    old_key_hash: bytes(32),
    new_key_hash: bytes(32),
    rewrapped_count: u32,
    rotated_at: u64,
}

// ── Streams ─────────────────────────────────────────────────────

stream encrypt_events: event<EncryptedCredential>
    retention 365d
    consumers [streamsight, audit]

stream key_rotation_events: event<VaultKeyRotation>
    retention 7y
    consumers [streamsight, governance, audit]

// ── Circuits ────────────────────────────────────────────────────

circuit encrypt_credential(
    vault_key: VaultKey,
    credential_id: bytes(16),
    plaintext: bytes,
    classification: u8,
    user_id: bytes(16),
) -> EncryptedCredential
    profile poly_framework_sensitive
    lex esn/global/org/polylabs/pass/encrypt
    status production
    precision C
    povc true
    constant_time true
    observe metrics: [encrypt_ops, encrypt_latency_ns, bytes_encrypted]
    monitor "encrypt_throughput" { encrypt_ops < 500/s }
    invariant "key_nonzero" { vault_key != zero(32) }
    invariant "plaintext_bounded" { len(plaintext) > 0 and len(plaintext) <= 65536 }
    invariant "valid_classification" { classification <= 2 }
    meters [compute_cycles, memory_bytes]
    wasm_abi [csprng, now]
    test golden "encrypt_basic_credential" {
        let vk = bytes(32, 0xAA)
        let cid = bytes(16, 0x01)
        let pt = "password123"
        let enc = encrypt_credential(vk, cid, pt, 0, bytes(16, 0x02))
        assert len(enc.ciphertext) > 0
        assert enc.credential_id == cid
        assert enc.nonce != zero(12)
    }
    kat_vector "aes_gcm_encrypt_credential" {
        key: bytes(32, 0xAA)
        nonce: bytes(12, 0xBB)
        plaintext: bytes(64, 0xCC)
        aad: bytes(64, 0xDD)
        function: aes_gcm_encrypt
    }
    kat_vector "hkdf_sha3_cred_key" {
        ikm: bytes(32, 0xAA)
        info: "cred-key:test"
        length: 32
        function: hkdf_sha3
    }
    fuzz_target "encrypt_credential_fuzz" {
        fuzz vault_key: bytes(32, random)
        fuzz credential_id: bytes(16, random)
        fuzz plaintext: bytes(random, 1..65536)
        fuzz classification: u8 { 0..2 }
        fuzz user_id: bytes(16, random)
        assert len(output.ciphertext) > 0
        assert output.tag != zero(16)
    }
{
    let cred_key = hkdf_sha3(vault_key, concat("cred-key:", credential_id), 32)
    let nonce = csprng(12)
    let aad = concat(credential_id, classification, sha3_256(user_id))
    let (ct, tag) = aes_gcm_encrypt(cred_key, nonce, plaintext, aad)

    let result = EncryptedCredential {
        credential_id: credential_id,
        nonce: nonce,
        ciphertext: ct,
        aad: aad,
        tag: tag,
    }

    polykit_metering::record_usage(user_id, "pass_encrypt", DimensionValues {
        executions: 1, hashes: 1, bandwidth: 0,
        storage: len(ct), observables: 1, proofs: 0, circuits: 0, mpc_sessions: 0,
    })

    result
}

circuit decrypt_credential(
    vault_key: VaultKey,
    encrypted: EncryptedCredential,
    user_id: bytes(16),
) -> bytes
    profile poly_framework_sensitive
    lex esn/global/org/polylabs/pass/encrypt
    status production
    precision C
    povc true
    constant_time true
    observe metrics: [decrypt_ops, decrypt_latency_ns, decrypt_failures]
    monitor "decrypt_failure_rate" { decrypt_failures / decrypt_ops < 0.01 }
    invariant "key_nonzero" { vault_key != zero(32) }
    invariant "tag_present" { len(encrypted.tag) == 16 }
    meters [compute_cycles, memory_bytes]
    wasm_abi [now]
    test golden "decrypt_roundtrip" {
        let vk = bytes(32, 0xAA)
        let cid = bytes(16, 0x01)
        let uid = bytes(16, 0x02)
        let enc = encrypt_credential(vk, cid, "secret", 0, uid)
        let pt = decrypt_credential(vk, enc, uid)
        assert pt == "secret"
    }
{
    let cred_key = hkdf_sha3(vault_key, concat("cred-key:", encrypted.credential_id), 32)
    let plaintext = aes_gcm_decrypt(cred_key, encrypted.nonce, encrypted.ciphertext, encrypted.aad, encrypted.tag)

    polykit_metering::record_usage(user_id, "pass_decrypt", DimensionValues {
        executions: 1, hashes: 1, bandwidth: 0,
        storage: 0, observables: 1, proofs: 0, circuits: 0, mpc_sessions: 0,
    })

    plaintext
}

circuit derive_vault_key(
    master_seed: bytes(32),
    vault_epoch: u32,
) -> WrappedVaultKey
    profile poly_framework_sensitive
    lex esn/global/org/polylabs/pass/encrypt
    status production
    precision C
    povc true
    constant_time true
    observe metrics: [vault_key_derivations]
    invariant "seed_nonzero" { master_seed != zero(32) }
    meters [compute_cycles, memory_bytes]
    wasm_abi [csprng]
    test golden "derive_vault_key_deterministic" {
        let seed = bytes(32, 0xCC)
        let wk = derive_vault_key(seed, 0)
        assert len(wk.kem_ciphertext) == 1568
        assert wk.nonce != zero(12)
    }
    kat_vector "mlkem_encaps_vault_key" {
        pk: bytes(1568, 0xCC)
        function: mlkem_encaps
    }
{
    let keys = polykit_identity::derive_keys(master_seed, "poly-pass-v1")
    let vault_key = hkdf_sha3(master_seed, concat("vault-key:epoch:", vault_epoch), 32)
    let wrap_nonce = csprng(12)
    let kem = mlkem_encaps(keys.encryption_public_key)
    let wrap_key = hkdf_sha3(kem.shared_secret, "vault-key-wrap", 32)
    let (wrapped, _tag) = aes_gcm_encrypt(wrap_key, wrap_nonce, vault_key, concat("vault-wrap:", vault_epoch))

    WrappedVaultKey {
        kem_ciphertext: kem.ciphertext,
        wrapped_key: wrapped,
        nonce: wrap_nonce,
    }
}

circuit rotate_vault_key(
    old_vault_key: VaultKey,
    new_master_seed: bytes(32),
    new_epoch: u32,
    credential_ids: list<bytes(16)>,
    encrypted_credentials: list<EncryptedCredential>,
    user_id: bytes(16),
    signing_sk: bytes(4896),
) -> VaultKeyRotation
    profile poly_framework_sensitive
    lex esn/global/org/polylabs/pass/encrypt
    status production
    precision C
    povc true
    constant_time true
    observe metrics: [key_rotations, credentials_rewrapped, rotation_latency_ns]
    monitor "rotation_size" { credentials_rewrapped < 10000 }
    invariant "keys_differ" { old_vault_key != hkdf_sha3(new_master_seed, concat("vault-key:epoch:", new_epoch), 32) }
    invariant "count_match" { len(credential_ids) == len(encrypted_credentials) }
    meters [compute_cycles, memory_bytes]
    wasm_abi [csprng, now]
{
    let new_vault_key = hkdf_sha3(new_master_seed, concat("vault-key:epoch:", new_epoch), 32)
    let old_key_hash = sha3_256(old_vault_key)
    let new_key_hash = sha3_256(new_vault_key)

    let count = 0
    parallel for i in 0..len(credential_ids) {
        let plaintext = decrypt_credential(old_vault_key, encrypted_credentials[i], user_id)
        let _re_encrypted = encrypt_credential(new_vault_key, credential_ids[i], plaintext, 0, user_id)
        count = count + 1
    }

    let rotation = VaultKeyRotation {
        old_key_hash: old_key_hash,
        new_key_hash: new_key_hash,
        rewrapped_count: count,
        rotated_at: now_ns() / 1000000,
    }

    let _sig = mldsa_sign(signing_sk, serialize(rotation))
    emit(key_rotation_events, rotation)

    polykit_metering::record_usage(user_id, "pass_key_rotate", DimensionValues {
        executions: 1, hashes: count + 2, bandwidth: 0,
        storage: count * 512, observables: 1, proofs: 1, circuits: 0, mpc_sessions: 0,
    })

    rotation
}
