// Poly Pass Metering — Per-product 8D metering for Poly Pass operations (v0.11.0)
//
// Lex Architecture:
//   esn/global/org/polylabs/pass/metering
//   Isolated under polylabs.pass.metering lex namespace.
//   8 dimensions: Executions, Hashes, Bandwidth, Storage, Observables, Proofs, Circuits, MpcSessions.
//
//  Operation                 | E | H | B | S | O | P | C | M |
//  --------------------------+---+---+---+---+---+---+---+---+
//  store (encrypt/decrypt)   | 1 | 1 |   | * | 1 |   |   |   |
//  autofill (match + fill)   | 1 |   |   |   | 1 |   |   |   |
//  share (create/accept)     | 1 | 2 | * | * | 1 | 1 |   |   |
//  breach_check              | 1 | 2 | * |   | 1 |   |   |   |
//  import                    | 1 | * |   | * | 1 | * |   |   |
//  key_rotation              | 1 | * |   | * | 1 | 1 |   |   |
//  vault_graph_write         | 1 | 1 |   | * | * | 1 |   |   |
//  share_graph_write         | 1 | 1 | * | * | * | 1 |   |   |
//  health_report             | 1 |   |   |   | * |   |   |   |

import polykit_metering

// ── Enums ───────────────────────────────────────────────────────

type PassMeteringCategory = enum {
    Store,
    Autofill,
    Share,
    BreachCheck,
    Import,
    KeyRotation,
    VaultGraphWrite,
    ShareGraphWrite,
    HealthReport,
}

// ── Data Declarations (Stratum + Cortex) ────────────────────────

data PassTierLimits : pass v1 {
    tier_name: string,
    max_credentials: u32,
    max_devices: u32,
    max_shares: u32,
    max_breach_checks_per_day: u32,
    max_imports_per_day: u32,
    base_limits: polykit_metering::TierLimits,
}
    store kv
    govern lex esn/global/org/polylabs/pass/metering
    cortex {
        infer on_read
    }

data PassUsageSummary : pass v1 {
    user_id: bytes(16),
    credential_count: u32,
    device_count: u32,
    share_count: u32,
    breach_checks_today: u32,
    imports_today: u32,
    dimensions: polykit_metering::DimensionValues,
    period_start: u64,
}
    store kv
    govern lex esn/global/org/polylabs/pass/metering
    cortex {
        obfuscate [user_id]
        infer on_write
        on_anomaly alert "pass-team"
    }

// ── Streams ─────────────────────────────────────────────────────

stream pass_metering_events: event<polykit_metering::MeteringRecord>
    | throttle 500/s burst 1000
    retention 365d
    consumers [streamsight, billing, governance]

// ── Circuits ────────────────────────────────────────────────────

circuit meter_store(
    user_id: bytes(16),
    credential_bytes: u64,
) -> polykit_metering::MeteringRecord
    profile poly_framework_standard
    lex esn/global/org/polylabs/pass/metering
    precision B
    observe metrics: [store_metering_ops]
    monitor "store_metering_rate" { store_metering_ops < 5000/s }
    meters [compute_cycles, memory_bytes]
    wasm_abi [eslite_insert, stream_emit, now]
{
    let dims = polykit_metering::DimensionValues {
        executions: 1,
        hashes: 1,
        bandwidth: 0,
        storage: credential_bytes,
        observables: 1,
        proofs: 0,
        circuits: 0,
        mpc_sessions: 0,
    }
    polykit_metering::record_usage(user_id, "pass_store", dims)
}

circuit meter_autofill(
    user_id: bytes(16),
) -> polykit_metering::MeteringRecord
    profile poly_framework_standard
    lex esn/global/org/polylabs/pass/metering
    precision B
    observe metrics: [autofill_metering_ops]
    meters [compute_cycles, memory_bytes]
    wasm_abi [eslite_insert, stream_emit, now]
{
    let dims = polykit_metering::DimensionValues {
        executions: 1,
        hashes: 0,
        bandwidth: 0,
        storage: 0,
        observables: 1,
        proofs: 0,
        circuits: 0,
        mpc_sessions: 0,
    }
    polykit_metering::record_usage(user_id, "pass_autofill", dims)
}

circuit meter_share(
    user_id: bytes(16),
    wrapped_key_bytes: u64,
) -> polykit_metering::MeteringRecord
    profile poly_framework_standard
    lex esn/global/org/polylabs/pass/metering
    precision B
    observe metrics: [share_metering_ops]
    meters [compute_cycles, memory_bytes]
    wasm_abi [eslite_insert, stream_emit, now]
{
    let dims = polykit_metering::DimensionValues {
        executions: 1,
        hashes: 2,
        bandwidth: wrapped_key_bytes,
        storage: 512,
        observables: 1,
        proofs: 1,
        circuits: 0,
        mpc_sessions: 0,
    }
    polykit_metering::record_usage(user_id, "pass_share", dims)
}

circuit meter_breach_check(
    user_id: bytes(16),
    response_bytes: u64,
) -> polykit_metering::MeteringRecord
    profile poly_framework_standard
    lex esn/global/org/polylabs/pass/metering
    precision B
    observe metrics: [breach_metering_ops]
    meters [compute_cycles, memory_bytes]
    wasm_abi [eslite_insert, stream_emit, now]
{
    let dims = polykit_metering::DimensionValues {
        executions: 1,
        hashes: 2,
        bandwidth: response_bytes,
        storage: 0,
        observables: 1,
        proofs: 0,
        circuits: 0,
        mpc_sessions: 0,
    }
    polykit_metering::record_usage(user_id, "pass_breach_check", dims)
}

circuit check_pass_tier_limits(
    user_id: bytes(16),
    category: u8,
    tier: PassTierLimits,
    current_usage: PassUsageSummary,
) -> list<string>
    profile poly_framework_standard
    lex esn/global/org/polylabs/pass/metering
    precision B
    observe metrics: [tier_checks, tier_violations]
    meters [compute_cycles, memory_bytes]
{
    let violations = []

    if current_usage.credential_count >= tier.max_credentials {
        violations = append(violations, "credential_limit_reached")
    }
    if current_usage.device_count >= tier.max_devices {
        violations = append(violations, "device_limit_reached")
    }
    if category == 2 and current_usage.share_count >= tier.max_shares {
        violations = append(violations, "share_limit_reached")
    }
    if category == 3 and current_usage.breach_checks_today >= tier.max_breach_checks_per_day {
        violations = append(violations, "breach_check_daily_limit")
    }
    if category == 4 and current_usage.imports_today >= tier.max_imports_per_day {
        violations = append(violations, "import_daily_limit")
    }

    let base_violations = polykit_metering::check_limits(current_usage.dimensions, tier.base_limits)
    for v in base_violations {
        if v != null {
            violations = append(violations, concat("dimension_exceeded:", v))
        }
    }

    violations
}

circuit get_pass_usage(
    user_id: bytes(16),
) -> PassUsageSummary
    profile poly_framework_standard
    lex esn/global/org/polylabs/pass/metering
    precision B
    observe metrics: [usage_queries]
    wasm_abi [eslite_query, now]
{
    let base = polykit_metering::get_usage_summary(user_id)

    PassUsageSummary {
        user_id: user_id,
        credential_count: 0,
        device_count: 0,
        share_count: 0,
        breach_checks_today: 0,
        imports_today: 0,
        dimensions: base,
        period_start: now_ns() / 1000000,
    }
}

// ── Test / KAT / Fuzz annotations ──────────────────────────────

test golden "meter_store_basic" {
    let uid = bytes(16, 0x01)
    let record = meter_store(uid, 256)
    assert record != null
}
